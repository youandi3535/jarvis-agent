#!/bin/bash
# JARVIS pre-commit 훅 — CLAUDE.md 박제 검증 자동 실행
#
# 설치 (1회):
#   git config core.hooksPath .githooks
#
# 동작:
#   위반이 있으면 **커밋을 차단**한다. 모드는 하나뿐이다.
#
#   ★ 종전엔 "기본=경고 / JARVIS_STRICT=1 이면 차단" 두 모드라고 *적혀* 있었다.
#     실제로는 맨 위 `set -e` 가 검사기 실패 즉시 스크립트를 죽여서 경고 모드도
#     JARVIS_STRICT 분기도 **2달간 단 한 번도 실행된 적이 없다**(실측 재현 완료).
#     그 사이 커밋 446건이 차단 모드로 멀쩡히 쌓였다 — 차단이 발목을 잡은 적이 없다.
#     그래서 되살리지 않고 **없앴다.** 있는 그대로가 규칙이다.
#     (`set -e` = "명령 하나라도 실패하면 즉시 멈춰라" 는 셸 관용구. 실패를
#      *받아서 판단하려는* 코드와는 애초에 양립할 수 없다 — 둘이 같은 파일에
#      태어난 것이 이 사고의 전부다.)
#
# 비활성 (급할 때):
#   git commit --no-verify

ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$ROOT/shared/precommit_check.py"

# ★ 3원칙 상기를 **검사보다 먼저** 띄운다 (위치 교정 2026-08-05).
#   종전엔 검사기 호출 *뒤* 에 있었다. 위반이 있으면 그 지점에서 스크립트가 끝나므로
#   **3원칙을 어겨서 위반이 잡힌 바로 그 순간에만 이 문구가 사라졌다** — 의도와 정반대.
#   원래 의도(2026-07-22 사용자 박제): "CLAUDE.md 는 Claude Code 세션에서만 로드된다.
#   커밋은 어떤 도구로 작업하든 반드시 거치므로 여기 두면 *모든 경로* 에서 눈에 들어온다."
#   → 먼저 띄우면 통과하든 막히든 항상 보인다.
echo "── 커밋 전 3원칙 자가점검 (CLAUDE.md 최상단) ──────────────────"
echo "  ① 단일 진입점 — 같은 로직·상수가 두 곳에 남지 않았는가?"
echo "  ② 동적 설계   — 박은 숫자·목록·경로를 런타임 파생으로 바꿨는가?"
echo "  ③ 모든 글 적용 — 네이버·티스토리 / 경제·테마 4조합 전부 확인했는가?"
echo "────────────────────────────────────────────────────────────"
echo ""

# ★ 검증기가 없으면 '통과' 가 아니라 '차단' (fail-closed — 2026-08-05).
#   종전엔 `exit 0` 이었다. 검사기를 실수로 지우거나 경로가 어긋나면 훅은 조용히
#   모든 커밋을 통과시킨다 — 게이트가 있는 줄 알면서 없는 상태가 가장 위험하다.
if [ ! -f "$SCRIPT" ]; then
    echo "❌ precommit_check.py 없음 — 검증기가 사라졌습니다."
    echo "   검사를 '통과' 로 처리하지 않습니다. 복구 후 다시 commit 하세요."
    echo "   임시 우회: git commit --no-verify"
    exit 1
fi

# ★ 커밋 잔여 검사 — "워킹트리를 깨끗이 비운다" 를 **기계가 본다** (2026-08-07).
#
#   CLAUDE.md 커밋 규정: 내가 수정하지 않은 파일(데몬이 갱신한 학습 산출물 등)도
#   함께 커밋해 `git status` 잔여를 0으로 만든다. 미커밋 방치는 ① checkout·브랜치
#   이동 시 소실 ② 추적 불가 ③ 회고·롤백 불가.
#
#   ★ 왜 훅에 넣나 — 이 규칙만 사람 손에 맡겨져 있어서 반복해서 샜다.
#     ①②(단일 진입점·동적 설계)는 precommit_check 가 강제하고, ③(모든 곳 적용)은
#     2026-08-05 에 `symmetry` 카테고리로 기계에 올렸다. 커밋 위생만 남아 있었다.
#     "규정을 읽었다" 는 적용의 증거가 아니다 — 읽어도 작업 끝 순간엔 주의가
#     '고친 게 되나' 에 쏠려 있다. 사람(과 에이전트)의 기억에 기대지 않는다.
#
#   미추적(??)·미스테이징(변경 O 스테이징 X) 파일이 있으면 차단한다.
#   급할 때 우회: git commit --no-verify
_leftover="$(git status --porcelain | grep -vE '^[MADRC]' || true)"
if [ -n "$_leftover" ]; then
    echo "❌ 커밋 잔여가 있습니다 — 워킹트리를 비우고 커밋하세요 (CLAUDE.md 커밋 규정)"
    echo ""
    echo "$_leftover" | sed 's/^/    /'
    echo ""
    echo "  런타임 학습 산출물도 *함께* 커밋합니다 — 미커밋 방치는 소실·추적불가·롤백불가."
    echo "    git add -A && git commit ..."
    echo "  의도적으로 남기려면: git commit --no-verify"
    exit 1
fi

# ★ `set -e` 없음 — 검사기의 실패를 *받아서* 우리가 판단한다.
python3 "$SCRIPT"
status=$?

if [ $status -eq 0 ]; then
    exit 0
fi

echo ""
echo "❌ 위반이 남아 있어 commit 을 중단했습니다."
echo ""
echo "  다음 한 걸음:"
echo "    1) 위 목록의 파일:행 을 고친다 (3원칙 ①②③ 대조)"
echo "    2) 카테고리 목록  : python3 shared/precommit_check.py --list"
echo "    3) 한 개만 재검사 : python3 shared/precommit_check.py --category <이름>"
echo ""
echo "  오탐이라고 판단되면 — 검사는 대부분 글자 찾기라 주석·문자열을 코드로"
echo "  착각할 수 있습니다 — 우회한 뒤 검사 규칙 자체를 고치세요:"
echo "    git commit --no-verify"
exit 1
